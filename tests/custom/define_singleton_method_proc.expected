define_singleton_method(:x, proc) => :x
o.x(3) => 6
o.x(1, 2) => ArgumentError: wrong number of arguments (given 2, expected 1)
define_singleton_method(:y) { } => :y
o.y => 1
define_singleton_method(:z, 1) => TypeError: wrong argument type Integer (expected Proc)
define_singleton_method(:z, proc {}, 3) => ArgumentError: wrong number of arguments (given 3, expected 1..2)
define_singleton_method arity => -2
